//
// Renode virtual machine for the host app (board: renode_cortex_m3).
//
// Keep in sync with host/boards/renode_cortex_m3/renode_cortex_m3.dts:
//   ROM   256 KiB @ 0x0
//   RAM   32 MiB @ 0x20000000
//   CPU   Cortex-M3 @ 100 MHz (systick)
//   uart0 console  arm,pl011 @ 0x40000000  IRQ 0
//   uart1 bus      arm,pl011 @ 0x40040000  IRQ 1
//

rom: Memory.MappedMemory @ sysbus 0x0
    size: 0x40000

ram: Memory.MappedMemory @ sysbus 0x20000000
    size: 0x2000000

cpu: CPU.CortexM @ sysbus
    cpuType: "cortex-m3"
    nvic: nvic0
    PerformanceInMips: 100

nvic0: IRQControllers.NVIC @ sysbus 0xe000e000
    -> cpu@0
    systickFrequency: 100000000

uart0: UART.PL011 @ sysbus 0x40000000
    frequency: 100000000
    -> nvic0@0

uart1: UART.PL011 @ sysbus 0x40040000
    frequency: 100000000
    -> nvic0@1
